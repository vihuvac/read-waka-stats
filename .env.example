# Copy to .env and fill in values:
#   cp .env.example .env
#
# Compose defaults DEBUG_RUN=true and MOCK_WAKATIME=true so the action prints
# generated markdown locally without cloning or publishing.

# Required — GitHub API is still used in debug mode (Classic PAT - simplest for local runs).
INPUT_GH_TOKEN=<INPUT_GH_TOKEN>

# Optional — defaults to the token owner.
INPUT_GH_USER=<INPUT_GH_USER>

# Optional when MOCK_WAKATIME=true (Compose default). Required for live WakaTime.
INPUT_WAKATIME_API_KEY=<INPUT_WAKATIME_API_KEY>

# Uncomment / set other action inputs as needed (see action.yml).
# INPUT_LOCALE=en
# INPUT_SECTION_NAME=waka
# INPUT_SHOW_LANGUAGE_COUNT=5
# INPUT_DEBUG_LOGGING=true
# INPUT_BADGE_STYLE=flat
#
# To call live WakaTime instead of fixtures, override in the shell:
# MOCK_WAKATIME=false docker compose run --rm app
